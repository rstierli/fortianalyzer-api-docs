{
  "image": "gitlab.frval.fortinet-emea.com:4567/support/cse-intl-cmm/cmm-sphinx-docker-image/sphinx-multiarch:latest",
  "initializeCommand": "docker pull gitlab.frval.fortinet-emea.com:4567/support/cse-intl-cmm/cmm-sphinx-docker-image/sphinx-multiarch:latest",
  "workspaceMount": "src=${localWorkspaceFolder},dst=/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "runArgs": ["--env-file","config/project.env","--rm"],
  "postStartCommand": "poststart.sh",
  "remoteEnv": {
    "LOCAL_WS_FOLDER": "${localWorkspaceFolderBasename}",
    "DOCKER_CONTAINER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ExecutableBookProject.myst-highlight",
        "bierner.markdown-preview-github-styles",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/ssh-host,type=bind,readonly=true"
  ]
}
